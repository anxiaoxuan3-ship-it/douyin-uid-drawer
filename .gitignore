# ============================================================
#  UID 抽号器 · Git 忽略规则
#  目标：仓库里只留源码和文档，控制在 1 MB 以内。
# ============================================================

# ---- 打包产物 ----------------------------------------------------
# exe 请通过 GitHub Releases 发布，不要提交进仓库
# （每次打包都会变，二进制进 Git 历史后删不掉，仓库会迅速膨胀）
*.exe
*.spec
build_out/
build_tmp/
dist/

# ---- 便携 Python --------------------------------------------------
# 约 19 MB，克隆仓库的人不需要它：没装便携版时会自动用系统 Python
tools/python/

# ---- 抖音直连的浏览器配置 ------------------------------------------
# 里面是 Chrome 的缓存和组件，能涨到几百 MB
tools/抖音弹幕直连/浏览器配置/

# ---- 运行时数据（含参与池、配置、弹幕日志）--------------------------
数据/
_临时/

# ---- Python -------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
develop-eggs/

# ---- 系统 ---------------------------------------------------------
Thumbs.db
ehthumbs.db
desktop.ini
*.lnk
.DS_Store

# ---- 编辑器 / IDE -------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 本机专用的说明文件（内容是「这台机器上怎么启动」）--------------
程序位置说明.txt

# ---- 安装包产物 --------------------------------------------------
# 生成的 Setup.exe 有 30 多 MB，不进仓库；脚本 安装包.iss 要留着
安装包/*.exe
